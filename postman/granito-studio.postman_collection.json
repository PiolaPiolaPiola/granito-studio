{
  "info": {
    "name": "Granito Studio API",
    "description": "Escenarios de prueba de la API. Importa también el entorno `granito-studio.postman_environment.json` y corre la colección en orden (cada paso guarda ids en el entorno para los siguientes). Requiere `npm run seed`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Salud",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Estado del servidor y de MongoDB.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin (guarda el token)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión con el usuario admin del seed y guarda `token` en el entorno.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailAdmin}}\",\n  \"contrasena\": \"{{contrasenaAdmin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login vendedor (guarda tokenVendedor)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión con el vendedor del seed.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailVendedor}}\",\n  \"contrasena\": \"{{contrasenaVendedor}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('tokenVendedor', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Perfil (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Datos del usuario del token.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es admin', () => pm.expect(pm.response.json().usuario.rol).to.eql('admin'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Error: sin token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Error: login con email inválido → 400",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Validación con zod: devuelve `detalles` por campo. Cuenta como intento fallido para el límite de 5.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"no-es-email\",\n  \"contrasena\": \"x\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', () => pm.response.to.have.status(400));",
                  "pm.test('Trae detalles', () => pm.expect(pm.response.json().detalles).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Granitos",
      "item": [
        {
          "name": "Listar (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/granitos?pagina=1&porPagina=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "granitos"
              ],
              "query": [
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "porPagina",
                  "value": "5"
                }
              ]
            },
            "description": "Respuesta: `{ granitos, pagina, porPagina, total, totalPaginas }`.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Trae metadatos', () => pm.expect(pm.response.json()).to.have.keys('granitos','pagina','porPagina','total','totalPaginas'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar sin tildes + filtros",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/granitos?busqueda=artico&tipo=granito&acabado=brillante",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "granitos"
              ],
              "query": [
                {
                  "key": "busqueda",
                  "value": "artico"
                },
                {
                  "key": "tipo",
                  "value": "granito"
                },
                {
                  "key": "acabado",
                  "value": "brillante"
                }
              ]
            },
            "description": "\"artico\" encuentra \"Blanco Ártico\". También: `etiqueta`, `incluirInactivos=true` (solo admin).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear (multipart con imagen)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/granitos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "granitos"
              ]
            },
            "description": "multipart/form-data. En Postman elige un archivo JPG/PNG/WEBP en el campo `imagen` (con Newman se usa `postman/muestra-granito.png`). Guarda `granitoId`.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "nombre",
                  "value": "Granito Postman {{$timestamp}}",
                  "type": "text"
                },
                {
                  "key": "tipo",
                  "value": "granito",
                  "type": "text"
                },
                {
                  "key": "acabado",
                  "value": "mate",
                  "type": "text"
                },
                {
                  "key": "etiquetas",
                  "value": "oscuro",
                  "type": "text"
                },
                {
                  "key": "etiquetas",
                  "value": "moderno",
                  "type": "text"
                },
                {
                  "key": "imagen",
                  "type": "file",
                  "src": "muestra-granito.png"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('granitoId', pm.response.json().granito._id);",
                  "pm.test('Trae Location', () => pm.response.to.have.header('Location'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver detalle",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/granitos/{{granitoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "granitos",
                "{{granitoId}}"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver la imagen subida",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/granitos/{{granitoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "granitos",
                "{{granitoId}}"
              ]
            },
            "description": "Abre `imagenUrl` en el navegador para ver la foto.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('imagenUrl en /uploads', () => pm.expect(pm.response.json().granito.imagenUrl).to.match(/^\\/uploads\\/granitos\\//));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar (JSON)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/granitos/{{granitoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "granitos",
                "{{granitoId}}"
              ]
            },
            "description": "También acepta multipart para cambiar la imagen.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"acabado\": \"brillante\",\n  \"etiquetas\": [\n    \"oscuro\",\n    \"elegante\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Error: vendedor no puede editar → 403",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/granitos/{{granitoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "granitos",
                "{{granitoId}}"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenVendedor}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"acabado\": \"mate\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Error: id inexistente → 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/granitos/000000000000000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "granitos",
                "000000000000000000000000"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Inactivar (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/granitos/{{granitoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "granitos",
                "{{granitoId}}"
              ]
            },
            "description": "Queda `active: false`; sale del catálogo pero los diseños lo siguen viendo.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reactivar",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/granitos/{{granitoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "granitos",
                "{{granitoId}}"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Activo otra vez', () => pm.expect(pm.response.json().granito.active).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
