# Copia este archivo como .env y ajusta los valores. El .env nunca se sube al repositorio.

# Entorno: development | production | test
NODE_ENV=development
PORT=4000

# MongoDB (docker compose up -d levanta una instancia local)
MONGODB_URI=mongodb://localhost:27017/granito_studio

# JWT: usa un valor largo y aleatorio. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Origen del frontend permitido por CORS. En Render se puede omitir: se usa la URL del servicio.
CORS_ORIGIN=http://localhost:5173

# Carpeta donde se guardan las imágenes subidas (relativa a server/)
UPLOADS_DIR=uploads

# Cloudinary (opcional): con las tres, las imágenes van a la nube en vez de UPLOADS_DIR.
# En Render gratis hacen falta: su disco se borra en cada despliegue y las fotos se perderían.
# https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- IA gratuita (opcional) -----------------------------------------------------------
# Sin claves la app funciona igual: "Llenar desde la foto" usa solo los colores (sin IA) y
# los comandos de voz usan reglas locales. Con una o varias claves, se prueban en este orden
# y si una agota su cuota se pasa a la siguiente. Una cuenta por proveedor.
# OJO: en los planes gratis el proveedor puede usar lo que se envía para mejorar sus modelos.
IA_ORDEN=gemini,groq,openrouter
# https://aistudio.google.com/apikey
IA_GEMINI_API_KEY=
# Google retira los modelos viejos para cuentas nuevas: si da 404, revisa la lista en AI Studio
IA_GEMINI_MODELO=gemini-3.5-flash
# https://console.groq.com/keys (también transcribe audios con Whisper)
IA_GROQ_API_KEY=
IA_GROQ_MODELO=meta-llama/llama-4-scout-17b-16e-instruct
IA_GROQ_MODELO_AUDIO=whisper-large-v3-turbo
# https://openrouter.ai/keys (modelos que terminan en :free)
IA_OPENROUTER_API_KEY=
IA_OPENROUTER_MODELO=google/gemma-3-27b-it:free
