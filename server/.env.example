# Copia este archivo como .env y ajusta los valores. El .env nunca se sube al repositorio.

# Entorno: development | production | test
NODE_ENV=development
PORT=4000

# MongoDB (docker compose up -d levanta una instancia local)
MONGODB_URI=mongodb://localhost:27017/granito_studio

# JWT: usa un valor largo y aleatorio. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Origen del frontend permitido por CORS 
CORS_ORIGIN=http://localhost:5173
